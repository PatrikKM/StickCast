<Window x:Class="StickCast.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StickCast – Mini ovladač" Width="440" Height="124"
        Topmost="True" WindowStyle="ToolWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F3F4F8" FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner">
    <Border Style="{StaticResource Card}" Margin="6" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Text="Nic se nepřehrává" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock x:Name="StateText" Grid.Column="1" Foreground="#6B7280" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="⏮" Padding="9,5" Margin="2" Style="{StaticResource Secondary}" ToolTip="Předchozí" Click="Prev_Click"/>
                    <Button Content="⏯" Padding="9,5" Margin="2" ToolTip="Pauza / Pokračovat" Click="PlayPause_Click"/>
                    <Button Content="⏹" Padding="9,5" Margin="2" Style="{StaticResource Secondary}" ToolTip="Stop" Click="Stop_Click"/>
                    <Button Content="⏭" Padding="9,5" Margin="2" Style="{StaticResource Secondary}" ToolTip="Další" Click="Next_Click"/>
                </StackPanel>
                <Slider x:Name="VolumeSlider" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0"
                        Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                        ValueChanged="VolumeSlider_ValueChanged" ToolTip="Hlasitost"/>
                <TextBlock x:Name="VolumeText" Grid.Column="2" Text="30%" Width="34" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="#6B7280"/>
            </Grid>
        </Grid>
    </Border>
</Window>
