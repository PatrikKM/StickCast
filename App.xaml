<Application x:Class="StickCast.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- VLC Media Player Palette Brushes (switched dynamically between Dark & Light) -->
        <SolidColorBrush x:Key="VlcOrange" Color="#FF8800"/>
        <SolidColorBrush x:Key="VlcOrangeHover" Color="#FF9E2C"/>
        <SolidColorBrush x:Key="VlcOrangePressed" Color="#E07000"/>
        <SolidColorBrush x:Key="VlcOrangeSubtle" Color="#3D260A"/>
        <SolidColorBrush x:Key="VlcBgDark" Color="#1B1C1F"/>
        <SolidColorBrush x:Key="VlcCardBg" Color="#24262B"/>
        <SolidColorBrush x:Key="VlcInputBg" Color="#151619"/>
        <SolidColorBrush x:Key="VlcDropdownBg" Color="#202227"/>
        <SolidColorBrush x:Key="VlcTabHoverBg" Color="#2C2F36"/>
        <SolidColorBrush x:Key="VlcListHoverBg" Color="#252830"/>
        <SolidColorBrush x:Key="VlcSecondaryBg" Color="#32353E"/>
        <SolidColorBrush x:Key="VlcSecondaryHover" Color="#3E424D"/>
        <SolidColorBrush x:Key="VlcSecondaryPressed" Color="#282A30"/>
        <SolidColorBrush x:Key="VlcSecondaryBorder" Color="#484D59"/>
        <SolidColorBrush x:Key="VlcBorder" Color="#383C45"/>
        <SolidColorBrush x:Key="VlcTextPrimary" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="VlcTextBody" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="VlcTextMuted" Color="#A1A7B3"/>
        <SolidColorBrush x:Key="VlcHeaderText" Color="#FF9824"/>
        <SolidColorBrush x:Key="VlcLogBg" Color="#121316"/>
        <SolidColorBrush x:Key="VlcLogFg" Color="#FFB357"/>

        <!-- Primary VLC Orange Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource VlcOrange}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#FFA333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource VlcOrangeHover}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#FFB85C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource VlcOrangePressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary VLC Button -->
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource VlcSecondaryBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource VlcTextPrimary}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VlcSecondaryBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource VlcSecondaryHover}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource VlcOrange}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource VlcSecondaryPressed}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource VlcOrange}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VLC Card Container -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource VlcCardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VlcBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- TextBox with VLC Orange Focus Ring -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource VlcInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource VlcTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource VlcOrange}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource VlcOrange}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VlcBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource VlcOrange}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#636978"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox & ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource VlcDropdownBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource VlcTextPrimary}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource VlcOrange}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource VlcOrangeSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource VlcInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource VlcTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VlcBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#FF8800"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource VlcOrange}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource VlcOrange}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,4,28,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource VlcDropdownBg}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource VlcOrange}"
                                            CornerRadius="5">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VLC TabItem with Orange Active Bar -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource VlcTextMuted}"/>
            <Setter Property="Background" Value="{DynamicResource VlcDropdownBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VlcBorder}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,2,1,0"
                                CornerRadius="7,7,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource VlcTabHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource VlcTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource VlcCardBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource VlcOrange}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1,3,1,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource VlcHeaderText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox & ListBoxItem with VLC Orange Selection -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource VlcInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource VlcTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VlcBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource VlcTextPrimary}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource VlcListHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource VlcOrangeSubtle}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource VlcOrange}"/>
                                <Setter Property="Foreground" Value="{DynamicResource VlcTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox with VLC Orange Accent -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource VlcTextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="box" Width="17" Height="17" CornerRadius="4"
                                    Background="{DynamicResource VlcInputBg}"
                                    BorderBrush="{DynamicResource VlcSecondaryBorder}" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,7,0">
                                <Path x:Name="mark" Data="M 3 8 L 7 12 L 14 4"
                                      Stroke="#FFFFFF" StrokeThickness="2"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource VlcOrange}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource VlcOrange}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource VlcOrange}"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VLC Orange ProgressBar & Separator -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource VlcInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource VlcOrange}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource VlcBorder}"/>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource VlcBorder}"/>
            <Setter Property="Height" Value="1"/>
        </Style>

        <!-- Section Header with VLC Cone Orange Accent -->
        <Style TargetType="TextBlock" x:Key="H">
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource VlcHeaderText}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="EmptyHint">
            <Setter Property="Foreground" Value="{DynamicResource VlcTextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="24"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Application.Resources>
</Application>
