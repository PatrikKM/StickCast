<Window x:Class="StickCast.LocalMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StickCast – Lokální monitor"
        Width="1060" Height="660" MinWidth="560" MinHeight="360"
        Background="#000000" Foreground="#F9FAFB"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseMove="Window_MouseMove">
    <Grid x:Name="RootGrid" Background="#000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top control strip (VLC Dark & Orange) -->
        <Border x:Name="TopBar" Grid.Row="0" Background="#E61B1C1F" Padding="12,8" BorderBrush="#FF8800" BorderThickness="0,0,0,1.5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="FullscreenButton" Content="⛶ Celá obrazovka (F11)"
                            Padding="10,5" Margin="0,0,6,0"
                            Click="Fullscreen_Click"/>
                    <Button Content="✕ Zavřít" Style="{StaticResource Secondary}"
                            Padding="10,5"
                            Click="Close_Click"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="StickCast – Přehrávač na monitoru PC"
                               FontWeight="SemiBold" FontSize="14" Foreground="#FF9824"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MonitorLabelText" Text="💻 Tento počítač"
                               FontSize="11" Foreground="#A1A7B3"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Video / Photo stage + Enforced Yellow Subtitle Overlay -->
        <Grid Grid.Row="1" Background="#000000" MouseLeftButtonDown="VideoArea_MouseLeftButtonDown">
            <MediaElement x:Name="Player"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Stretch="Uniform"
                          ScrubbingEnabled="True"
                          MediaOpened="Player_MediaOpened"
                          MediaEnded="Player_MediaEnded"
                          MediaFailed="Player_MediaFailed"/>

            <Image x:Name="PhotoView"
                   Stretch="Uniform"
                   Visibility="Collapsed"/>

            <!-- High-contrast enforced yellow subtitle box -->
            <Border x:Name="SubtitleBorder"
                    Visibility="Collapsed"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="32,0,32,28"
                    Padding="18,8"
                    CornerRadius="8"
                    Background="#CC000000"
                    BorderBrush="#66000000"
                    BorderThickness="1"
                    IsHitTestVisible="False">
                <TextBlock x:Name="SubtitleText"
                           Foreground="#FFFF00"
                           FontFamily="Segoe UI"
                           FontWeight="Bold"
                           FontSize="28"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="1100">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="1"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Border>
        </Grid>

        <!-- Bottom VLC Transport Control Bar inside Video Window -->
        <Border x:Name="BottomBar" Grid.Row="2" Background="#F21B1C1F" Padding="12,8" BorderBrush="#FF8800" BorderThickness="0,1.5,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Seek / Timeline Row -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PosText" Grid.Column="0" Text="0:00:00" Foreground="#E5E7EB"
                               FontSize="12" VerticalAlignment="Center"/>
                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1"
                            IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="6,0"
                            PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                            PreviewMouseLeftButtonUp="SeekSlider_MouseUp"
                            ValueChanged="SeekSlider_ValueChanged"
                            ToolTip="Posun v čase (šipky ← / → ±10 s)"/>
                    <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00:00" Foreground="#A1A7B3"
                               FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Transport Buttons & Volume Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <Button Content="⏮ Předchozí" Style="{StaticResource Secondary}" Padding="10,5" Margin="2"
                                Click="PrevTrack_Click" ToolTip="Předchozí skladba / video"/>
                        <Button Content="⏪ -10s" Style="{StaticResource Secondary}" Padding="9,5" Margin="2"
                                Click="SeekBack_Click" ToolTip="Posunout zpět o 10 sekund (←)"/>
                        <Button x:Name="PlayPauseButton" Content="⏸ Pauza" Padding="14,5" Margin="2"
                                Click="PlayPause_Click" ToolTip="Pauza / Pokračovat (Mezerník)"/>
                        <Button Content="⏹ Stop" Style="{StaticResource Secondary}" Padding="10,5" Margin="2"
                                Click="Stop_Click" ToolTip="Zastavit přehrávání"/>
                        <Button Content="⏩ +10s" Style="{StaticResource Secondary}" Padding="9,5" Margin="2"
                                Click="SeekForward_Click" ToolTip="Posunout vpřed o 10 sekund (→)"/>
                        <Button Content="⏭ Další" Padding="12,5" Margin="2"
                                Click="NextTrack_Click" ToolTip="Další skladba / video v seznamu"/>
                    </WrapPanel>

                    <TextBlock x:Name="StateBadgeText" Grid.Column="1" Text="▶ přehrává"
                               Foreground="#FF9824" FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0"/>

                    <Button x:Name="MuteButton" Grid.Column="2" Content="🔊" Style="{StaticResource Secondary}"
                            Padding="8,4" Margin="2" Click="Mute_Click" ToolTip="Ztlumit zvuk (M)"/>
                    <Slider x:Name="VolumeSlider" Grid.Column="3" Minimum="0" Maximum="100" Value="80"
                            IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="6,0"
                            ValueChanged="VolumeSlider_ValueChanged" ToolTip="Hlasitost (+/-)"/>
                    <TextBlock x:Name="VolumeText" Grid.Column="4" Text="80%" Foreground="#FF9824"
                               FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <Button x:Name="BottomFullscreenButton" Grid.Column="5" Content="⛶" Style="{StaticResource Secondary}"
                            Padding="9,4" Margin="8,2,2,2" Click="Fullscreen_Click" ToolTip="Celá obrazovka (F11 / dvojklik)"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
