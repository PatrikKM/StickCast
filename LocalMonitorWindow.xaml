<Window x:Class="StickCast.LocalMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StickCast – Lokální monitor"
        Width="1024" Height="620" MinWidth="480" MinHeight="320"
        Background="#000000" Foreground="#F9FAFB"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown">
    <Grid x:Name="RootGrid" Background="#000000" MouseLeftButtonDown="VideoArea_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top control strip -->
        <Border x:Name="TopBar" Grid.Row="0" Background="#CC111827" Padding="12,8" BorderBrush="#374151" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="FullscreenButton" Content="⛶ Celá obrazovka (F11)"
                            Background="#2563EB" Foreground="White" BorderThickness="0"
                            Padding="10,5" Margin="0,0,6,0" Cursor="Hand"
                            Click="Fullscreen_Click"/>
                    <Button Content="✕ Zavřít"
                            Background="#374151" Foreground="White" BorderThickness="0"
                            Padding="10,5" Cursor="Hand"
                            Click="Close_Click"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="StickCast – Přehrávač na monitoru PC"
                               FontWeight="SemiBold" FontSize="14" Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MonitorLabelText" Text="💻 Tento počítač"
                               FontSize="11" Foreground="#9CA3AF"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Video / Photo stage + Enforced Yellow Subtitle Overlay -->
        <Grid Grid.Row="1" Background="#000000">
            <MediaElement x:Name="Player"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Stretch="Uniform"
                          ScrubbingEnabled="True"
                          MediaOpened="Player_MediaOpened"
                          MediaEnded="Player_MediaEnded"
                          MediaFailed="Player_MediaFailed"/>

            <Image x:Name="PhotoView"
                   Stretch="Uniform"
                   Visibility="Collapsed"/>

            <!-- High-contrast enforced yellow subtitle box -->
            <Border x:Name="SubtitleBorder"
                    Visibility="Collapsed"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="32,0,32,36"
                    Padding="18,8"
                    CornerRadius="8"
                    Background="#CC000000"
                    BorderBrush="#66000000"
                    BorderThickness="1"
                    IsHitTestVisible="False">
                <TextBlock x:Name="SubtitleText"
                           Foreground="#FFFF00"
                           FontFamily="Segoe UI"
                           FontWeight="Bold"
                           FontSize="28"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="1100">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="1"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</Window>
